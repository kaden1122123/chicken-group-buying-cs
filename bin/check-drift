#!/bin/bash
# bin/check-drift
# Round 24 (2026-07-25 12:00+) — 檢查 3 層位置 drift

echo "=== Drift Check: 3 層位置 ==="
DEV_REPO="/home/clawuser/openclaw-workspace/others/chicken-group-buying-customer-service"
MAIN_MIRROR="/home/clawuser/.openclaw/workspace-external-user/projects/chicken-group-buying-customer-service"
PROD_RUNTIME="/home/clawuser/.openclaw/agents/external-user"

echo "1. dev repo <-> main mirror (rsync consistency)"
diff -rq "$DEV_REPO" "$MAIN_MIRROR" 2>&1 | grep -v "^Only in\|Permission denied" | head -10 || echo "✅ 完全一致"

echo ""
echo "2. dev repo docs/production-prompt/ <-> prod runtime (canonical files)"
# Round 37.4 fix：使用 latest symlink 而非 hardcode 2026-07-03
CANONICAL_DIR="$DEV_REPO/docs/production-prompt/latest"
if [ ! -d "$CANONICAL_DIR" ]; then
  CANONICAL_DIR="$DEV_REPO/docs/production-prompt/2026-07-03"  # fallback
fi
# Round 37.22 (Hubert 15:20) 修整：改用 md5 比對內容，避開 sync-canonical.sh 後 mtime 必新於 docs 但內容一致的誤判警告
# AGENTS.md 特殊：prod 有 14 行 CANONICAL header（by design），需 skip
for f in AGENTS.md SOUL.md main_idea.md; do
  if [ -f "$CANONICAL_DIR/$f" ] && [ -f "$PROD_RUNTIME/$f" ]; then
    DEV_MD5=$(md5sum "$CANONICAL_DIR/$f" 2>/dev/null | awk '{print $1}')
    if [ "$f" = "AGENTS.md" ]; then
      PROD_MD5=$(tail -n +14 "$PROD_RUNTIME/$f" 2>/dev/null | md5sum | awk '{print $1}')
    else
      PROD_MD5=$(md5sum "$PROD_RUNTIME/$f" 2>/dev/null | awk '{print $1}')
    fi
    if [ -z "$DEV_MD5" ] || [ -z "$PROD_MD5" ] || [ "$DEV_MD5" != "$PROD_MD5" ]; then
      echo "⚠️  $f: content drift（md5 不一致）"
    else
      echo "✅ $f: 同步（md5 一致）"
    fi
  else
    echo "❌ $f: missing"
  fi
done

echo ""
echo "3. config.yaml drift (vs chicken.yaml)"
cd "$DEV_REPO"
if [ -f config.yaml ] && [ -f config/tenants/chicken.yaml ]; then
  if bash scripts/sync-config.sh 2>&1 | grep -q "預期 1"; then
    echo "✅ config.yaml 同步（separator count 1）"
  else
    echo "⚠️  config.yaml 可能 drift，run sync-config.sh 確認"
  fi
fi

echo ""
echo "✅ Drift check 完成"
