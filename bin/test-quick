#!/bin/bash
# bin/test-quick
# Round 25 (2026-07-25 13:00+) — 快速跑 subset 測試（< 10 秒）
#
# 設計：
#   - 只跑關鍵 5 個 test（KB matching + config + customer tags）
#   - 跳過大型 integration test（api-server.test.js 等）
#   - 開發時快速驗證用
#
# 使用：
#   bash bin/test-quick               # 跑快速 subset
#   bash bin/test-quick --full        # 跑全部（等同 npm test）

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$PROJECT_ROOT"

# 顏色
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

ok() { echo -e "${GREEN}✅${NC} $1"; }
warn() { echo -e "${YELLOW}⚠️${NC} $1"; }

if [ "${1:-}" = "--full" ]; then
  ok "跑全部測試（npm test）..."
  npm test
  exit $?
fi

ok "跑快速 subset 測試（< 10 秒）..."
echo ""

# 1. Worker KB matching tests（5 個 node:test）— Round 17+18 必跑
echo "  [1/5] Worker KB matching tests..."
cd /home/clawuser/openclaw-workspace/external-user/cloudflare-worker
if [ -f tests/kb-matching.test.mjs ]; then
  node --test tests/kb-matching.test.mjs 2>&1 | tail -5
  cd "$PROJECT_ROOT"
else
  warn "Worker tests/kb-matching.test.mjs 不存在（跳過）"
  cd "$PROJECT_ROOT"
fi

# 2. Config test（驗 chicken.yaml 載入）
echo ""
echo "  [2/5] Config test..."
if [ -f tests/config.test.js ]; then
  node tests/config.test.js 2>&1 | tail -5
else
  warn "tests/config.test.js 不存在（跳過）"
fi

# 3. Customer tags test
echo ""
echo "  [3/5] Customer tags test..."
if [ -f tests/customer-tags.test.js ]; then
  node tests/customer-tags.test.js 2>&1 | tail -5
else
  warn "tests/customer-tags.test.js 不存在（跳過）"
fi

# 4. Whitelist / address test
echo ""
echo "  [4/5] Address + Whitelist tests..."
for t in tests/address-handoff.test.js tests/whitelist.test.js; do
  if [ -f "$t" ]; then
    node "$t" 2>&1 | tail -3
  else
    warn "$t 不存在（跳過）"
  fi
done

# 5. Pending / KB test
echo ""
echo "  [5/5] Pending + KB tests..."
for t in tests/pending.test.js tests/verify-kb-sources.js; do
  if [ -f "$t" ]; then
    node "$t" 2>&1 | tail -3
  else
    warn "$t 不存在（跳過）"
  fi
done

echo ""
ok "test-quick 完成（跳過大型 integration test）"
echo "  跑全部：bash bin/test-quick --full"
