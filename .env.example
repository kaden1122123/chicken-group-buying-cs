# ============================================================
# 雞肉團購 AI 客服 — 環境變數範例
# 路徑: chicken-group-buying-customer-service/.env
# 複製此檔案為 .env 並填入真實值
# ============================================================

# ─────────────────────────────────────────
# LINE Bot（從 LINE Developer Console 取得）
# ─────────────────────────────────────────
LINE_BOT_TOKEN=your_line_channel_access_token_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# ─────────────────────────────────────────
# 街口支付 QR Code URL（如有）
# ─────────────────────────────────────────
JKO_QR_CODE_URL=https://your-jko-qr-code-url-here

# ─────────────────────────────────────────
# Google Sheets（Phase 2 使用）
# ─────────────────────────────────────────
GOOGLE_SHEETS_ID=your_spreadsheet_id_here
GOOGLE_CREDENTIALS_PATH=./google-credentials.json

# ─────────────────────────────────────────
# 通知設定
# ─────────────────────────────────────────
HUBERT_LINE_USER_ID=Uf56650056d35626deb64165926a26182
# HUBERT_LINE_BOT_TOKEN 已移除：同一隻 LINE Bot 用於接收客戶訊息 + 通知 Hubert