# ============================================================
# 雞肉團購 AI 客服 — 環境變數範例
# 路徑: chicken-group-buying-customer-service/.env
# 複製此檔案為 .env 並填入真實值
# 對齊：Session I（2026-06-29）+ Session K（logger）+ Session X5（health）+ Round 19 LINE bot 整合
# 最後更新：2026-07-24 10:50 (Round 19 LINE bot config 整合)
# ============================================================

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 1. LINE Bot（從 LINE Developer Console 取得）
#    切換真實帳號時改這 3 個值即可（見 docs/LINE_BOT_SETUP.md）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# api-server / chicken.yaml 使用（env var reference）
LINE_BOT_TOKEN=your_line_channel_access_token_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# Cloudflare Worker 直接使用（dashboard 或 wrangler secret put 設定）
# Worker 程式會優先讀 LINE_BOT_TOKEN，fallback LINE_ACCESS_TOKEN
LINE_ACCESS_TOKEN=your_line_channel_access_token_here  # 向後相容，請改用 LINE_BOT_TOKEN

# 街口支付 QR Code URL
JKO_QR_CODE_URL=https://your-jko-qr-code-url-here

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 2. API Server（Session I 加的）
#    啟動指令: nohup env API_USERNAME=... node scripts/api-server.js
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
API_USERNAME=api-user
API_PASSWORD=your_api_password_here
API_SERVER_PORT=3001

# I2：CORS 白名單（逗號分隔 origin）。空字串 = 關閉 CORS
API_CORS_ORIGINS=

# I3：rate limit（每分鐘最大 request 數）
API_RATE_LIMIT=60

# I3：rate limit 時間窗（毫秒）
API_RATE_LIMIT_WINDOW_MS=60000

# I1：graceful shutdown 強制退出時間（毫秒）
API_GRACEFUL_TIMEOUT_MS=10000

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 3. Dashboard Server（Session P0）
#    啟動指令: nohup env DASHBOARD_USERNAME=... node scripts/dashboard-server.js
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
DASHBOARD_USERNAME=admin
DASHBOARD_PORT=3000

# Dashboard 需要 api-server credentials 才能代理 /api/* 請求
DASHBOARD_API_PROXY_URL=http://127.0.0.1:3001

# Dashboard 顯示的 Worker health check URL（讓 /healthz worker=up）
WORKER_HEALTH_URL=https://external-user-line-security.kaden1122123.workers.dev/api/knowledge/stats

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 4. I4：input validation 長度上限
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
API_INPUT_USER_LINE_NAME_MAX=100
API_INPUT_ADDRESS_MAX=500
API_INPUT_COMMUNITY_MAX=100

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 5. K：logger 設定
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
LOG_LEVEL=info
LOG_FORMAT=json  # json | text

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 6. X5：health check 設定
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
HEALTH_CHECK_TIMEOUT_MS=5000

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 7. L：notify_owner + LLM fallback 設定
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
NOTIFY_OWNER_ENABLED=true
NOTIFY_OWNER_LINE_USER_ID=Uf56650056d35626deb64165926a26182  # Hubert 個人 LINE ID

# LLM fallback (OpenClaw Gateway URL + 認證)
OPENCLAW_GATEWAY_URL=https://openclaw.brt1122.com
OPENCLAW_GATEWAY_TOKEN=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 8. M：Gmail OAuth fallback（LINE push 失敗時用 Email 通知）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
GMAIL_CREDENTIALS_PATH=/home/clawuser/.config/chicken/secrets/gmail-credentials.json
GMAIL_TOKEN_PATH=/home/clawuser/.config/chicken/secrets/gmail-token.json
GMAIL_NOTIFY_TO=k.chang.8844@gmail.com

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 9. Cloudflare Worker 環境變數（透過 wrangler secret put 設定）
#    指令: echo "VALUE" | wrangler secret put NAME
#    對應: ~/openclaw-workspace/external-user/cloudflare-worker/wrangler.toml
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# LINE_CHANNEL_SECRET=xxx  # 已在 Cloudflare Worker dashboard 設定
# LINE_BOT_TOKEN=xxx  # canonical（新），未來換 bot 改這一個即可
# LINE_ACCESS_TOKEN=xxx  # 向後相容（deprecated），可選保留

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 10. 整合測試 / E2E
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
E2E_TEST_ENABLED=false
E2E_DRY_RUN=true

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 換 Bot Checklist（執行時 uncomment 並填值）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# LINE_BOT_TOKEN=<NEW_TOKEN>           # 新 bot 的 Channel access token
# LINE_CHANNEL_SECRET=<NEW_SECRET>    # 新 bot 的 Channel secret
# NOTIFY_OWNER_LINE_USER_ID=<NEW_OWNER_LINE_ID>  # 新老闆的 LINE User ID
# echo "$LINE_BOT_TOKEN" | wrangler secret put LINE_BOT_TOKEN
# echo "$LINE_CHANNEL_SECRET" | wrangler secret put LINE_CHANNEL_SECRET
# bash scripts/sync-config.sh
# ps aux | grep "scripts/api-server" | grep -v grep | awk '{print $2}' | xargs kill
# cd /home/clawuser/openclaw-workspace/others/chicken-group-buying-customer-service
# nohup env API_USERNAME=api-user API_PASSWORD_FILE=/home/clawuser/.config/chicken/secrets/api-pwd X_API_TOKEN_FILE=/home/clawuser/.config/chicken/secrets/api-token PORT=3001 node scripts/api-server.js > /tmp/api-server.log 2>&1 &
# 詳見 docs/LINE_BOT_SETUP.md
