# ============================================================
# 雞肉團購 AI 客服 — 環境變數範例
# 路徑: chicken-group-buying-customer-service/.env
# 複製此檔案為 .env 並填入真實值
# 對齊：Session I（2026-06-29）+ Session K（logger）+ Session X5（health）後的 30 個 env
# 最後更新：2026-07-03 17:25
# ============================================================

# ─────────────────────────────────────────
# LINE Bot（從 LINE Developer Console 取得）
# ─────────────────────────────────────────
LINE_BOT_TOKEN=your_line_channel_access_token_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# ─────────────────────────────────────────
# 街口支付 QR Code URL
# ─────────────────────────────────────────
JKO_QR_CODE_URL=https://your-jko-qr-code-url-here

# ─────────────────────────────────────────
# API Server（Session I 加的）
# ─────────────────────────────────────────
API_USERNAME=api-user
API_PASSWORD=your_api_password_here
API_SERVER_PORT=3001
# I2：CORS 白名單（逗號分隔 origin）。空字串 = 關閉 CORS
API_CORS_ORIGINS=
# I3：rate limit（每分鐘最大 request 數）
API_RATE_LIMIT=60
# I3：rate limit 時間窗（毫秒）
API_RATE_LIMIT_WINDOW_MS=60000
# I1：graceful shutdown 強制退出時間（毫秒）
API_GRACEFUL_TIMEOUT_MS=10000

# ─────────────────────────────────────────
# I4：input validation 長度上限
# ─────────────────────────────────────────
API_INPUT_USER_LINE_NAME_MAX=100
API_INPUT_ADDRESS_MAX=500
API_INPUT_COMMUNITY_MAX=100
API_INPUT_TIME_SLOT_MAX=50
API_INPUT_PAYMENT_METHOD_MAX=50
API_INPUT_PAYMENT_STATUS_MAX=50
API_INPUT_ORDER_STATUS_MAX=50
API_INPUT_STAFF_NOTES_MAX=1000
API_INPUT_CUSTOMER_NOTES_MAX=1000

# ─────────────────────────────────────────
# Dashboard Server（Session I + Session X5）
# ─────────────────────────────────────────
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=your_dashboard_password_here

# ─────────────────────────────────────────
# Logging（Session K）
# ─────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=logs

# ─────────────────────────────────────────
# Timezone（測試用）
# ─────────────────────────────────────────
TZ=Asia/Taipei
# 設為 true 讓測試可以 override timezone
ALLOW_TIMEZONE_OVERRIDE=false

# ─────────────────────────────────────────
# Tenant（multi-tenant）
# ─────────────────────────────────────────
TENANT_ID=chicken

# ─────────────────────────────────────────
# Knowledge cache（Session X4-B）
# ─────────────────────────────────────────
KNOWLEDGE_CACHE_TTL_MS=30000

# ─────────────────────────────────────────
# Mock（測試用，production 絕對不要設）
# ─────────────────────────────────────────
# MOCK_TODAY=2026-06-15T10:00:00+08:00

# ─────────────────────────────────────────
# Worker health check URL（Session X5-B）
# ─────────────────────────────────────────
WORKER_HEALTH_URL=https://your-worker-url/health

# ─────────────────────────────────────────
# 舊欄位（待移除用說明，程式不再讀）
# ─────────────────────────────────────────
# ~~GOOGLE_SHEETS_ID~~ — Phase 2 沒實作，移除
# ~~GOOGLE_CREDENTIALS_PATH~~ — Phase 2 沒實作，移除
# ~~HUBERT_LINE_USER_ID~~ — 不是 env，從 config 讀
