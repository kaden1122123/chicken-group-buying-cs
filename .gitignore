node_modules/
.env
*.log
.DS_Store
dashboard.tmp.html
# CSV 訂單資料：預設排除，避免測試訂單污染 git
# 但保留 2026-06-13.csv 跟 2026-06-16.csv（真實訂單，PHASE1 第一筆）
data/orders/**/*.csv
!data/orders/chicken/2026-06-13.csv
!data/orders/chicken/2026-06-16.csv
# 保留 .gitkeep
!data/orders/**/.gitkeep
# Session D D2 併發測試 tenant（獨立隔離避免誤刪 chicken tenant 真實訂單）
data/orders/_csv_concurrency_test/
knowledge/tenants/_csv_concurrency_test/

# config.yaml.bak.* — sync-config.sh 自動產生的備份副本（Decision 3B，2026-07-15）
# git 不追蹤；要回退就用本機檔案 cp 即可
config.yaml.bak.*

# P9: Google Sheets service account JSON（絕對禁止 commit）
**/google-service-account*.json
**/google-credentials*.json

# B 方案：X-API-Token（絕對禁止 commit，OpenClaw exec 也會 redact）
